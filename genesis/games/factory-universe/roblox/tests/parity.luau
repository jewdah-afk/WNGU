-- Parity test: replays the JS bot session (Fixture.luau, generated by
-- tools/gen-roblox.mjs) through the Luau sim and compares every checkpoint
-- hash. Run with Lune from this folder's parent:  lune run tests/parity
local Sim = require("../src/shared/Sim")
local Content = require("../src/shared/Content")
local F = require("./Fixture")

local st = Sim.createWorld(Content, { seed = F.seed })
local th = Sim.terrainHash(st)
assert(th == F.terrainHash, `terrain hash {th} ~= JS {F.terrainHash}`)
print(`terrain ok ({th})`)

local want = {}
for _, c in F.checkpoints do want[c[1]] = c[2] end

local ci, fails, checked = 1, 0, 0
local t0 = os.clock()
while st.tick < F.endTick do
	while ci <= #F.commands and F.commands[ci][1] == st.tick do
		local c = F.commands[ci]
		local r = Sim.applyCommand(st, { c[2], c[3], c[4], c[5], c[6] })
		if not r.ok then print(`command {ci} failed at tick {st.tick}: {r.reason}`); fails += 1 end
		ci += 1
	end
	if want[st.tick] then
		local h = Sim.stateHash(st)
		checked += 1
		if h ~= want[st.tick] then
			print(`DIVERGED at tick {st.tick}: luau {h} js {want[st.tick]}`)
			fails += 1
			break
		end
	end
	Sim.step(st)
	table.clear(st.events)
end
if want[st.tick] then
	checked += 1
	if Sim.stateHash(st) ~= want[st.tick] then fails += 1; print(`DIVERGED at final tick {st.tick}`) end
end
print(`{checked} checkpoints, {fails} failures, {F.endTick} ticks in {string.format("%.2f", os.clock() - t0)} s`)
if fails > 0 then error("parity FAILED") end
print("parity OK")
